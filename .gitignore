# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Local SQLite databases and storage
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.sqlite
backend/data/*.backup*
backend/data/*.bak
!backend/data/.gitkeep

# Machine learning model artifacts (for future milestones)
models/*.pkl
models/*.pt
models/*.onnx
models/*.bin
!models/.gitkeep

# Build output
dist/
frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Editor and OS files
.vscode/
.DS_Store
Thumbs.db
