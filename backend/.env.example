# ===============================================
# CARES Healthcare Platform - Backend Environment Configuration
# ===============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (Relative or absolute path to SQLite file)
DATABASE_PATH=./data/cares.db

# Authentication / JWT Configuration
# In production, replace with a 64+ character cryptographically secure secret
JWT_SECRET=cares_capstone_jwt_development_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
