# ==============================================================================
# CARES Backend REST API — Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env or configure in your deployment environment.
# ==============================================================================

# Server network port (default: 5000)
PORT=5000

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS client origin (default: http://localhost:5173 for local Vite dev)
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file path (relative to backend root, or absolute path)
DATABASE_PATH=./data/cares.db

# Reverse proxy trust configuration (set to 1, true, or proxy IP if behind a reverse proxy / TLS-terminator)
# TRUST_PROXY=1

# JWT Authentication Secret
# CRITICAL: In production (NODE_ENV=production), the application will strictly
# refuse to start if JWT_SECRET is unset, empty, or using the development default.
# Minimum required length in production: 32 characters.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long_for_production

# JWT token expiration window (e.g., '1d', '7d', '24h')
JWT_EXPIRES_IN=7d
