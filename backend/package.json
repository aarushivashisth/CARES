{
  "name": "cares-backend",
  "version": "1.0.0",
  "description": "CARES Healthcare Navigation Platform REST API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/initDb.js",
    "db:seed": "node src/db/seed.js",
    "import:local": "node src/scripts/importLocalProviders.js",
    "test": "node --test test/**/*.test.js",
    "db:migrate:postgres": "node src/db/migrate.js",
    "knowledge:build": "node src/scripts/buildKnowledge.js",
    "evaluate:ai": "node src/scripts/evaluateAI.js"
  },
  "keywords": [
    "healthcare",
    "express",
    "sqlite",
    "rest-api"
  ],
  "author": "CARES Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13"
  },
  "engines": {
    "node": ">=24"
  }
}
