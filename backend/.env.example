# Local backend only. Enter real values privately; never commit .env.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Choose a NEW disposable path for development. Never seed an existing database.
DATABASE_PATH=./data/cares.development-choose-new-name.db
# For managed PostgreSQL, set DATABASE_URL instead of SQLite.
# Production requires sslmode=verify-full. Use a pooled connection in Functions.
DATABASE_URL=
# Protected live SQLite access is disabled. This is NOT permission to open it.
# Set true only after explicit owner authorization and backup review.
ALLOW_PROTECTED_DATABASE=false
TRUST_PROXY=1
# Replace privately with a random key; the placeholder is rejected in production.
JWT_SECRET=replace_with_private_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
# Backend-only LLM configuration. Never put keys in frontend/.env or VITE_*.
# Use a model eligible for your account's free tier; quotas still apply.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional existing provider: select LLM_PROVIDER=anthropic to use these instead.
# Gemini errors never trigger an automatic Anthropic/paid fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# CLI-only, one-time admin bootstrap. Do not set these in Vercel or Git.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
