# ==============================================================================
# CARES Platform — Root Environment Template
# ==============================================================================
# Copy this file to .env for local development or set the variables in your
# deployment platform (e.g., Docker, systemd, Kubernetes, cloud provider).
# Real secrets and sensitive credentials must never be committed to Git.
# ==============================================================================

# Backend REST API configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/cares.db

# Reverse proxy trust configuration (set to 1, true, or proxy IP if behind reverse proxy / TLS-terminator)
# TRUST_PROXY=1

# JWT Authentication
# REQUIRED IN PRODUCTION: Must be a cryptographically secure random string (min 32 chars).
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long_for_production
JWT_EXPIRES_IN=7d

# Frontend Vite configuration
VITE_API_URL=http://localhost:5000/api
